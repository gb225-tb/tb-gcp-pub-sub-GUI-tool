{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tailoredbrands.com/schemas/product_message/2.0",
  "title": "ProductMessage",
  "description": "Flat SKU-level product ingest message derived from TBUniverseProducts feed. All 74 columns are carried as raw strings using the source PascalCase header names. Type coercion (booleans, numbers, arrays, dates) happens downstream in ProductDocumentMapper.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "ItemCode",
    "ParentProductCode",
    "Division",
    "DivisionDescription",
    "SizeCode",
    "PrimarySize",
    "ProductColorCode",
    "ColorBreakoutDesc",
    "Categories"
  ],

  "properties": {
    "ItemCode":            { "type": "string", "minLength": 1, "description": "Unique SKU identifier. S.No 1." },
    "ParentProductCode":   { "type": "string", "minLength": 1, "description": "Style-level grouping key. S.No 2." },
    "Group":               { "type": ["string", "null"], "description": "Product group code within SubDivision. S.No 3." },
    "SuperGroup":          { "type": ["string", "null"], "description": "Broadest classification above Division. S.No 4." },
    "SubDivision":         { "type": ["string", "null"], "description": "Sub-category within Division. S.No 5." },
    "Division":            { "type": "string", "minLength": 1, "description": "Numeric division code. S.No 6." },
    "DivisionDescription": { "type": "string", "minLength": 1, "description": "Human-readable division name. S.No 7." },
    "SuperDivision":       { "type": ["string", "null"], "description": "Top-level gender or business division. S.No 8." },
    "ItemCreateDate":      { "type": ["string", "null"], "description": "Item creation date in source system (MM/DD/YYYY). S.No 9." },
    "ItemUpdateDate":      { "type": ["string", "null"], "description": "Last modification date in source system (MM/DD/YYYY). S.No 10." },
    "WebLongDesc":         { "type": ["string", "null"], "description": "Full product description for PDP. S.No 11." },
    "WebFlag":             { "type": ["string", "null"], "description": "true/false flag as string (0/1/2). S.No 12." },
    "SizeCode":            { "type": "string", "minLength": 1, "description": "3-digit size code. S.No 13." },
    "SizeDescription":     { "type": ["string", "null"], "description": "Human-readable size label. S.No 14." },
    "PrimarySize":         { "type": "string", "minLength": 1, "description": "Chest/body numeric size. S.No 15." },
    "SizeDimension":       { "type": ["string", "null"], "description": "Garment length dimension (SHORT/REGULAR/LONG). S.No 16." },
    "SizeSequence":        { "type": ["string", "null"], "description": "Display sort order for size options. S.No 17." },
    "ProductColorCode":    { "type": "string", "minLength": 1, "description": "2-digit zero-padded color code. S.No 18." },
    "ColorDesc":           { "type": ["string", "null"], "description": "Internal color label. S.No 19." },
    "ColorBreakoutDesc":   { "type": "string", "minLength": 1, "description": "Marketing-facing color name. S.No 20." },
    "ColorFamily":         { "type": ["string", "null"], "description": "Broad color family for faceted filtering. S.No 21." },
    "MSRP":                { "type": ["string", "null"], "description": "Manufacturer Suggested Retail Price. S.No 22." },
    "CurrentCost":         { "type": ["string", "null"], "description": "Current wholesale cost. S.No 23." },
    "IsTemporaryMarkDown": { "type": ["string", "null"], "description": "Temporary promotional markdown flag (0/1). S.No 24." },
    "IsPermanentMarkdown": { "type": ["string", "null"], "description": "Permanent markdown flag (0/1). S.No 25." },
    "Fit":                 { "type": ["string", "null"], "description": "Garment silhouette/cut. S.No 26." },
    "Label":               { "type": ["string", "null"], "description": "Sub-brand or designer label. S.No 27." },
    "SeasonCode":          { "type": ["string", "null"], "description": "Season or replenishment code. S.No 28." },
    "BigAndTallFlag":      { "type": ["string", "null"], "description": "Big & Tall assortment indicator (0/1). S.No 29." },
    "BTClassCode":         { "type": ["string", "null"], "description": "Big & Tall merchandise class code. S.No 30." },
    "RegClassCode":        { "type": ["string", "null"], "description": "Regular merchandise class code. S.No 31." },
    "HazardousFlag":       { "type": ["string", "null"], "description": "Hazardous materials flag (0/1). S.No 32." },
    "NoWarehouseStock":    { "type": ["string", "null"], "description": "No warehouse inventory indicator (0/1). S.No 33." },
    "TaxTypeTaxware":      { "type": ["string", "null"], "description": "Taxware tax classification code. S.No 34." },
    "HeelHeight":          { "type": ["string", "null"], "description": "Heel height for footwear. S.No 35." },
    "Length":              { "type": ["string", "null"], "description": "Garment length descriptor. S.No 36." },
    "Material":            { "type": ["string", "null"], "description": "High-level fabric type. S.No 37." },
    "Content":             { "type": ["string", "null"], "description": "Full fiber content breakdown. S.No 38." },
    "Pattern":             { "type": ["string", "null"], "description": "Visual fabric pattern. S.No 39." },
    "Wash":                { "type": ["string", "null"], "description": "Fabric wash or treatment. S.No 40." },
    "Origin":              { "type": ["string", "null"], "description": "Country or region of manufacture. S.No 41." },
    "SpecialSizes":        { "type": ["string", "null"], "description": "Size range category (e.g. MENS REGULAR). S.No 42." },
    "Gender":              { "type": ["string", "null"], "description": "Target gender for this variant. S.No 43." },
    "CollectionName":      { "type": ["string", "null"], "description": "Merchandising collection or channel name. S.No 44." },
    "CareInstructions":    { "type": ["string", "null"], "description": "Garment care instructions. S.No 45." },
    "Categories":          { "type": "string", "minLength": 1, "description": "Browse/navigation categories ('<>'-delimited). S.No 46." },
    "Width":               { "type": ["string", "null"], "description": "Width dimension. S.No 47." },
    "JacketStyle":         { "type": ["string", "null"], "description": "Jacket button configuration. S.No 48." },
    "JacketLining":        { "type": ["string", "null"], "description": "Jacket interior lining type. S.No 49." },
    "JacketVent":          { "type": ["string", "null"], "description": "Jacket back vent style. S.No 50." },
    "PantStyle":           { "type": ["string", "null"], "description": "Trouser front style. S.No 51." },
    "PantFinish":          { "type": ["string", "null"], "description": "Trouser hem finish. S.No 52." },
    "AccessoryStyle":      { "type": ["string", "null"], "description": "Accessory style descriptor. S.No 53." },
    "LapelStyle":          { "type": ["string", "null"], "description": "Lapel shape type. S.No 54." },
    "PocketStyle":         { "type": ["string", "null"], "description": "Exterior pocket style. S.No 55." },
    "ShirtCollarStyle":    { "type": ["string", "null"], "description": "Collar style for dress shirts. S.No 56." },
    "ShirtCuffStyle":      { "type": ["string", "null"], "description": "Cuff style for dress shirts. S.No 57." },
    "SleeveLength":        { "type": ["string", "null"], "description": "Sleeve length descriptor. S.No 58." },
    "ShoeStyle":           { "type": ["string", "null"], "description": "Footwear style type. S.No 59." },
    "ShoeToeStyle":        { "type": ["string", "null"], "description": "Toe shape for footwear. S.No 60." },
    "ShoeSoleMaterial":    { "type": ["string", "null"], "description": "Sole material for footwear. S.No 61." },
    "ProductFeatures":     { "type": ["string", "null"], "description": "Bullet-point feature list. S.No 62." },
    "AdditionalCopy":      { "type": ["string", "null"], "description": "Marketing copy ('<>'-delimited). S.No 63." },
    "ProductAssociation":  { "type": ["string", "null"], "description": "Cross-sell product references ('<>'-delimited). S.No 64." },
    "DateAvailableToSell": { "type": ["string", "null"], "description": "First date SKU is available for purchase (MM/DD/YYYY). S.No 65." },
    "UPC":                 { "type": ["string", "null"], "description": "Universal Product Code barcode. S.No 66." },
    "LeverageClassCode":   { "type": ["string", "null"], "description": "Cost/leverage class code. S.No 67." },
    "Occasion":            { "type": ["string", "null"], "description": "Intended wear occasion ('<>'-delimited). S.No 68." },
    "Creaset":             { "type": ["string", "null"], "description": "Crease treatment for trouser legs. S.No 69." },
    "Hem":                 { "type": ["string", "null"], "description": "Hem finish type. S.No 70." },
    "MaxHemLength":        { "type": ["string", "null"], "description": "Maximum inseam length for alteration. S.No 71." },
    "Monogramming":        { "type": ["string", "null"], "description": "Monogramming availability indicator. S.No 72." },
    "PackageQty":          { "type": ["string", "null"], "description": "Units per sellable package. S.No 73." },
    "IsBundle":            { "type": ["string", "null"], "description": "Bundle product indicator (0/1). S.No 74." },
    "FileName":            { "type": ["string", "null"], "description": "Optional source file or message name plumbed through for audit. Not validated." },
    "MessageTimestamp":    { "type": ["string", "null"], "description": "Optional producer-stamped message timestamp (ISO-8601). Not validated." },
    "filename":            { "type": ["string", "null"], "description": "Optional lowercase alias of FileName plumbed through by streaming producers for audit. Not validated." },
    "messageTS":           { "type": ["string", "null"], "description": "Optional lowercase alias of MessageTimestamp (ISO-8601) stamped by streaming producers. Not validated." },
    "_DeltaStatus":        { "type": ["string", "null"], "enum": ["NEW", "UPDATED", "DELETED", "NOCHANGE", null], "description": "Streaming delta status: 'NEW'/'UPDATED'/'NOCHANGE' activate and stamp startDate (upsert); 'DELETED' soft-deletes the SKU and rolls the inactivation up to parents. Absent/null = upsert." }
  }
}
